<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Hereda versiones de Spring Boot. Debe coincidir con la que usa el SDK (7.3.x -> Spring Boot 4.0.x) -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.6</version>
    <relativePath/>
  </parent>

  <groupId>com.curso.alfresco</groupId>
  <artifactId>acs-oop-extension</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Curso :: Extension out-of-process para ACS</name>

  <properties>
    <java.version>17</java.version>
    <alfresco-java-sdk.version>7.3.3</alfresco-java-sdk.version>
  </properties>

  <dependencies>
    <!-- Escuchar eventos del repositorio (ActiveMQ) -->
    <dependency>
      <groupId>org.alfresco</groupId>
      <artifactId>alfresco-java-event-api-spring-boot-starter</artifactId>
      <version>${alfresco-java-sdk.version}</version>
    </dependency>
    <!-- Cliente Java de la REST API publica de ACS -->
    <dependency>
      <groupId>org.alfresco</groupId>
      <artifactId>alfresco-acs-java-rest-api-spring-boot-starter</artifactId>
      <version>${alfresco-java-sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
